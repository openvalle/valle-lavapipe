#version 450
// Each invocation writes an integer and a float that the probe recomputes on the CPU.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out {
  uint u[256];
  float f[256];
};
void main() {
  uint i = gl_GlobalInvocationID.x;
  u[i] = i * i + 7u;
  f[i] = sin(float(i) * 0.01);
}
